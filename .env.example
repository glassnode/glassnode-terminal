# glassnode-terminal configuration.
# Copy to .env and fill in. Load with: node --env-file=.env dist/cli.js
#
# The terminal runs in ONE of two modes. Provide credentials for the mode you want.
# When both are set, x402 wins unless you force a mode (GLASSNODE_MODE, or --api/--x402).

# ── Mode A: full API (free / metered tier) ─────────────────────────────
# Get a key at https://studio.glassnode.com/settings/api
GLASSNODE_API_KEY=

# ── Mode B: full x402 (pay-per-call in USDC on Base, no API key needed) ─
# A funded Base wallet private key. Data queries settle in USDC per call (~$0.05).
# The metric catalog is bundled (browsing is free); only opening data costs money.
X402_PRIVATE_KEY=
# Per-call spend cap in USDC (default 0.06):
X402_MAX_PAYMENT=0.06
# x402 host — omit for mainnet (x402.glassnode.com); set a testnet host to test:
# X402_API_URL=https://your-testnet-host
# Re-fetch the metric catalog live via x402 instead of using the bundle (paid):
# X402_REFRESH_CATALOG=1

# ── Optional: force a mode when both credentials are present ────────────
# 'api' or 'x402' (same as the --api / --x402 CLI flags):
# GLASSNODE_MODE=x402
