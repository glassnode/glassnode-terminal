{
  "name": "glassnode-terminal",
  "version": "0.1.0",
  "description": "Interactive TUI for exploring Glassnode on-chain crypto data",
  "type": "module",
  "bin": {
    "glassnode-terminal": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "sync-ink-uplot": "rm -rf node_modules/ink-uplot && mkdir -p node_modules/ink-uplot && cp ../ink-uplot/package.json node_modules/ink-uplot/ && cp -r ../ink-uplot/dist node_modules/ink-uplot/",
    "postinstall": "pnpm run sync-ink-uplot",
    "dev": "tsx --watch src/cli.tsx",
    "start": "node dist/cli.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "canvas": "^3.2.1",
    "glassnode-api": "^0.7.1",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "path2d": "^0.3.1",
    "react": "^19.2.4",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.14",
    "ink-testing-library": "^4.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
