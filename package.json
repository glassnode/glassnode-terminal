{
  "name": "glassnode-terminal",
  "version": "0.1.0",
  "description": "Interactive TUI for exploring Glassnode on-chain crypto data",
  "type": "module",
  "bin": {
    "glassnode-terminal": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/cli.tsx",
    "start": "node dist/cli.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "glassnode-api": "link:../glassnode-api",
    "ink": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
