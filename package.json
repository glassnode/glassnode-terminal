{
  "name": "glassnode-terminal",
  "version": "0.1.2",
  "description": "Interactive TUI for exploring Glassnode on-chain and market crypto data",
  "type": "module",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "bin": {
    "glassnode-terminal": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "sync-ink-uplot": "rm -rf node_modules/ink-uplot && mkdir -p node_modules/ink-uplot && cp ../ink-uplot/package.json node_modules/ink-uplot/ && cp -r ../ink-uplot/dist node_modules/ink-uplot/",
    "dev": "tsx --watch src/cli.tsx",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "glassnode",
    "crypto",
    "blockchain",
    "on-chain",
    "terminal",
    "tui",
    "cli",
    "ink",
    "react",
    "typescript",
    "bitcoin",
    "ethereum",
    "market-data",
    "chart",
    "dashboard"
  ],
  "author": {
    "name": "Jordi Planadecursach",
    "url": "https://github.com/planadecu"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/planadecu/glassnode-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/planadecu/glassnode-terminal/issues"
  },
  "homepage": "https://github.com/planadecu/glassnode-terminal#readme",
  "dependencies": {
    "@x402/evm": "2.17.0",
    "@x402/fetch": "2.17.0",
    "canvas": "^3.2.3",
    "chafa-wasm": "^0.3.3",
    "glassnode-api": "^0.8.2",
    "ink": "^7.1.0",
    "ink-spinner": "^5.0.0",
    "ink-uplot": "^0.2.13",
    "path2d": "^0.3.3",
    "react": "^19.2.7",
    "uplot": "^1.6.32",
    "viem": "2.55.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/ws": "^8.18.1",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "packageManager": "pnpm@10.32.1"
}
