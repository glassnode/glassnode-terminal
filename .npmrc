# Supply-chain hardening (added 2026-05-13)
ignore-scripts=true
minimum-release-age=10080   # 7 days in minutes
# typescript is published by Microsoft (trusted); exempt from the release-age gate.
# TS 7 is the native compiler, so its @typescript/* platform binaries need exempting too.
minimum-release-age-exclude[]=typescript
minimum-release-age-exclude[]=@typescript/*
# ink-uplot and glassnode-api are published by the repo author (trusted); exempt from the gate.
minimum-release-age-exclude[]=ink-uplot
minimum-release-age-exclude[]=glassnode-api
# @x402/* (Coinbase's official x402 packages, incl. transitive @x402/core) — glassnode-api's
# x402 needs ^2.18.0 to complete x402Version-2 payments; the mature 2.17.0 does not.
# Deliberate gate exception for the whole scope.
minimum-release-age-exclude[]=@x402/*
